# ============================================================
# chat-share — example environment
# Copy to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- Core ---

# Public base URL (the real domain where this is deployed).
# Used to generate share links. No trailing slash.
BASE_URL=https://share.yourdomain.cl

# HMAC secret for signing cookies. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=change-me-please-use-openssl-rand-hex-32

# Agent API keys, comma-separated. Share only with your own agents.
# Used to authenticate the REST API and the MCP endpoint.
AGENT_API_KEY=change-me-agent-key

# --- Optional: PocketID / OIDC (enables the admin panel) ---

# PocketID issuer, e.g. https://id.yourdomain.cl
OIDC_ISSUER=
# Client ID of the admin-panel client you created in PocketID.
OIDC_CLIENT_ID=chat-share
# Client secret, only if the client is confidential.
OIDC_CLIENT_SECRET=
# Audience required when validating MCP OAuth access tokens (optional).
OIDC_AUDIENCE=
# Restrict the admin panel to these OIDC subs, comma-separated (optional).
ADMIN_ALLOWED_SUBS=

# --- Optional: tuning ---

# Add the Secure flag to cookies. Keep true in production (TLS).
# Set to false only when testing over plain local HTTP.
COOKIE_SECURE=true
# Request body limit in bytes for API/MCP/unlock (default 1 MiB).
BODY_LIMIT=1048576
